{
  "publisher_id": "dtp",
  "name": "inventory",
  "version": "2.0.0",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "product_id",
      "observation",
      "occurred_at",
      "expected_revision",
      "moves",
      "reservations"
    ],
    "properties": {
      "product_id": {
        "type": "string",
        "maxLength": 36
      },
      "observation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "sequence"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 200
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "occurred_at": {
        "type": "string",
        "maxLength": 24
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "moves": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "quantity",
            "serial_ids",
            "reason",
            "links"
          ],
          "properties": {
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lot_id",
                "location_id",
                "status"
              ],
              "properties": {
                "lot_id": {
                  "type": "string",
                  "maxLength": 120,
                  "nullable": true
                },
                "location_id": {
                  "type": "string",
                  "maxLength": 120
                },
                "status": {
                  "type": "string",
                  "maxLength": 10,
                  "enum": [
                    "available",
                    "quarantine",
                    "damaged",
                    "expired",
                    "in_transit"
                  ]
                }
              }
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lot_id",
                "location_id",
                "status"
              ],
              "properties": {
                "lot_id": {
                  "type": "string",
                  "maxLength": 120,
                  "nullable": true
                },
                "location_id": {
                  "type": "string",
                  "maxLength": 120
                },
                "status": {
                  "type": "string",
                  "maxLength": 10,
                  "enum": [
                    "available",
                    "quarantine",
                    "damaged",
                    "expired",
                    "in_transit"
                  ]
                }
              }
            },
            "quantity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "unit"
              ],
              "properties": {
                "amount": {
                  "type": "string",
                  "maxLength": 24
                },
                "unit": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "system",
                    "code",
                    "packaging_id",
                    "version",
                    "base_units_per_pack"
                  ],
                  "properties": {
                    "system": {
                      "type": "string",
                      "maxLength": 9,
                      "enum": [
                        "ucum",
                        "packaging"
                      ]
                    },
                    "code": {
                      "type": "string",
                      "maxLength": 32,
                      "nullable": true
                    },
                    "packaging_id": {
                      "type": "string",
                      "maxLength": 80,
                      "nullable": true
                    },
                    "version": {
                      "type": "string",
                      "maxLength": 40,
                      "nullable": true
                    },
                    "base_units_per_pack": {
                      "type": "string",
                      "maxLength": 24,
                      "nullable": true
                    }
                  }
                }
              }
            },
            "serial_ids": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "nullable": true
            },
            "reason": {
              "type": "string",
              "maxLength": 200,
              "nullable": true
            },
            "links": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transformation_id",
                "order_id"
              ],
              "properties": {
                "transformation_id": {
                  "type": "string",
                  "maxLength": 36,
                  "nullable": true
                },
                "order_id": {
                  "type": "string",
                  "maxLength": 36,
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "reservations": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reservation_id",
            "position",
            "quantity",
            "party"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "maxLength": 7,
              "enum": [
                "reserve",
                "release",
                "fulfill"
              ]
            },
            "reservation_id": {
              "type": "string",
              "maxLength": 120
            },
            "position": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lot_id",
                "location_id",
                "status"
              ],
              "properties": {
                "lot_id": {
                  "type": "string",
                  "maxLength": 120,
                  "nullable": true
                },
                "location_id": {
                  "type": "string",
                  "maxLength": 120
                },
                "status": {
                  "type": "string",
                  "maxLength": 10,
                  "enum": [
                    "available",
                    "quarantine",
                    "damaged",
                    "expired",
                    "in_transit"
                  ]
                }
              }
            },
            "quantity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "unit"
              ],
              "properties": {
                "amount": {
                  "type": "string",
                  "maxLength": 24
                },
                "unit": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "system",
                    "code",
                    "packaging_id",
                    "version",
                    "base_units_per_pack"
                  ],
                  "properties": {
                    "system": {
                      "type": "string",
                      "maxLength": 9,
                      "enum": [
                        "ucum",
                        "packaging"
                      ]
                    },
                    "code": {
                      "type": "string",
                      "maxLength": 32,
                      "nullable": true
                    },
                    "packaging_id": {
                      "type": "string",
                      "maxLength": 80,
                      "nullable": true
                    },
                    "version": {
                      "type": "string",
                      "maxLength": 40,
                      "nullable": true
                    },
                    "base_units_per_pack": {
                      "type": "string",
                      "maxLength": 24,
                      "nullable": true
                    }
                  }
                }
              }
            },
            "party": {
              "type": "string",
              "maxLength": 36,
              "nullable": true
            }
          }
        }
      }
    }
  },
  "semantics": "inventory-v2",
  "dependencies": []
}
