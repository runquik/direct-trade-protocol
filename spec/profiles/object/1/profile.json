{
  "publisher_id": "dtp",
  "name": "object",
  "version": "1.0.0",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "class",
      "label",
      "identifiers",
      "status",
      "retired",
      "evidence"
    ],
    "properties": {
      "class": {
        "type": "string",
        "maxLength": 117
      },
      "label": {
        "type": "string",
        "maxLength": 200,
        "nullable": true
      },
      "identifiers": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "value"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "maxLength": 64
            },
            "value": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      },
      "status": {
        "type": "string",
        "maxLength": 7,
        "enum": [
          "active",
          "retired"
        ]
      },
      "retired": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "note"
        ],
        "nullable": true,
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 8,
            "enum": [
              "scrapped",
              "lost",
              "consumed",
              "ended",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        }
      },
      "evidence": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minted_by",
            "root",
            "record_id"
          ],
          "properties": {
            "minted_by": {
              "type": "string",
              "maxLength": 36,
              "nullable": true
            },
            "root": {
              "type": "string",
              "maxLength": 36
            },
            "record_id": {
              "type": "string",
              "maxLength": 36,
              "nullable": true
            }
          }
        }
      }
    }
  },
  "semantics": "object-v1",
  "dependencies": []
}
