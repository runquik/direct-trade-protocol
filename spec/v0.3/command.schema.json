{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pbp:0.3:command",
  "title": "Portable Business Protocol 0.3 signed command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "audience",
    "request_id",
    "issued_at",
    "expires_at",
    "organization_id",
    "actor",
    "requested_by",
    "action",
    "payload",
    "signatures"
  ],
  "properties": {
    "version": {
      "const": "0.3"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "organization_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "key_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "person",
            "installation"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
        }
      }
    },
    "requested_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "enum": [
        "person.register",
        "person.rotate",
        "organization.create",
        "organization.policy",
        "organizations.list",
        "membership.invite",
        "membership.accept",
        "membership.revoke",
        "module.publish",
        "installation.create",
        "installation.revoke",
        "workspace.view",
        "record.append",
        "records.list",
        "records.export",
        "organization.export",
        "migration.preview",
        "migration.commit",
        "migration.receipt",
        "migration.import"
      ]
    },
    "payload": {
      "type": "object"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "signature"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 110
          }
        }
      },
      "maxItems": 16,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "person.register"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keys"
            ],
            "properties": {
              "keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
                },
                "maxItems": 8,
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "person.rotate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "add",
              "revoke"
            ],
            "properties": {
              "add": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
                },
                "maxItems": 8,
                "minItems": 0,
                "uniqueItems": true
              },
              "revoke": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
                },
                "maxItems": 8,
                "minItems": 0,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "organization.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "nonce",
              "controllers",
              "threshold"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "nonce": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "controllers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "maxItems": 8,
                "minItems": 1,
                "uniqueItems": true
              },
              "threshold": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "organization.policy"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "controllers",
              "threshold"
            ],
            "properties": {
              "controllers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "maxItems": 8,
                "minItems": 1,
                "uniqueItems": true
              },
              "threshold": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "organizations.list"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "membership.invite"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invitation_id",
              "person_id",
              "permissions",
              "expires_at"
            ],
            "properties": {
              "invitation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "person_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 64,
                "minItems": 0,
                "uniqueItems": true
              },
              "expires_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "membership.accept"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invitation_id"
            ],
            "properties": {
              "invitation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "membership.revoke"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "person_id"
            ],
            "properties": {
              "person_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "module.publish"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module_id",
              "manifest"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "manifest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "name",
                  "permissions"
                ],
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "maxItems": 64,
                    "minItems": 0,
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "installation.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "installation_id",
              "module_id",
              "manifest_version",
              "key_id",
              "permissions",
              "mode",
              "expires_at"
            ],
            "properties": {
              "installation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "module_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "manifest_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "key_id": {
                "type": "string",
                "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "maxItems": 64,
                "minItems": 0,
                "uniqueItems": true
              },
              "mode": {
                "enum": [
                  "interactive",
                  "automation"
                ]
              },
              "expires_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "installation.revoke"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "installation_id"
            ],
            "properties": {
              "installation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "workspace.view"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "record.append"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "root_id",
              "supersedes",
              "type",
              "subject_company_id",
              "counterparty_ids",
              "visibility",
              "body"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "root_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "supersedes": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z_]+$"
              },
              "subject_company_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "counterparty_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "maxItems": 16,
                "minItems": 0,
                "uniqueItems": true
              },
              "visibility": {
                "enum": [
                  "public",
                  "counterparties",
                  "granted",
                  "private"
                ]
              },
              "body": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "records.list"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "after",
              "limit"
            ],
            "properties": {
              "after": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "records.export"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "after",
              "limit"
            ],
            "properties": {
              "after": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "organization.export"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "migration.preview"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "migration.commit"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination",
              "snapshot_hash"
            ],
            "properties": {
              "destination": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "audience",
                  "key_id"
                ],
                "properties": {
                  "audience": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "key_id": {
                    "type": "string",
                    "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
                  }
                }
              },
              "snapshot_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "migration.receipt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "migration.import"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transfer"
            ],
            "properties": {
              "transfer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "snapshot",
                  "handoff",
                  "source_key_id",
                  "signature"
                ],
                "properties": {
                  "snapshot": {
                    "type": "object"
                  },
                  "handoff": {
                    "type": "object"
                  },
                  "source_key_id": {
                    "type": "string",
                    "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{43,44}$"
                  },
                  "signature": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 110
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
