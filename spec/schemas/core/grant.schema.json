{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtp.dev/schemas/0.2/core/grant.schema.json",
  "title": "core.grant",
  "description": "A company's permission to a module. Subject is the granting company. MUST be signed by a company root key with issuer.module_id null (modules never write grants). Revocation = a superseding record with status revoked; only the head of the chain counts. `write` implies `read`.",
  "x-dtp-subject": "self",
  "x-dtp-default-visibility": "private",
  "x-dtp-roles": {},
  "x-dtp-transitions": {
    "status_field": "status",
    "initial": { "status": ["active"], "by": ["subject"] },
    "transitions": [
      { "from": "active", "to": "revoked", "by": ["subject"] },
      { "from": "active", "to": "active", "by": ["subject"], "note": "scope change" }
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x_": {} },
  "required": ["module_id", "scopes", "status"],
  "properties": {
    "module_id": { "$ref": "../common/ids.schema.json#/$defs/ModuleId" },
    "scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Scope" } },
    "status": { "type": "string", "enum": ["active", "revoked"] },
    "expires_at": { "oneOf": [{ "$ref": "../common/ids.schema.json#/$defs/DateTime" }, { "type": "null" }] },
    "note": { "type": ["string", "null"] }
  },
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^([a-z]+|\\*)$", "description": "A namespace, or * for all." },
        "type": { "$ref": "../common/ids.schema.json#/$defs/RecordType" },
        "access": { "type": "string", "enum": ["read", "write"] }
      },
      "oneOf": [
        { "required": ["namespace"], "not": { "required": ["type"] } },
        { "required": ["type"], "not": { "required": ["namespace"] } }
      ]
    }
  }
}
