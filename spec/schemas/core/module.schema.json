{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtp.dev/schemas/0.2/core/module.schema.json",
  "title": "core.module",
  "description": "A software identity with its own keys. Subject is the publisher company. The genesis record may be signed by a module root key listed in keys[] (self-certifying) or by a publisher root key. requested_scopes is advisory (consent screen); authority comes only from core.grant records.",
  "x-dtp-subject": "publisher_company_id",
  "x-dtp-default-visibility": "public",
  "x-dtp-roles": {},
  "x-dtp-transitions": null,
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x_": {} },
  "required": ["module_id", "name", "publisher_company_id", "keys"],
  "properties": {
    "module_id": { "$ref": "../common/ids.schema.json#/$defs/ModuleId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "publisher_company_id": { "$ref": "../common/ids.schema.json#/$defs/CompanyId" },
    "description": { "type": ["string", "null"] },
    "homepage": { "type": ["string", "null"] },
    "keys": { "type": "array", "minItems": 1, "items": { "$ref": "../common/key.schema.json" } },
    "requested_scopes": { "type": "array", "items": { "$ref": "grant.schema.json#/$defs/Scope" } }
  }
}
