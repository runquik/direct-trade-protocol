{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtp.dev/schemas/0.2/common/quantity.schema.json",
  "title": "Quantity",
  "description": "Decimal string with up to 3 fractional digits (milliamount precision) plus a unit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["amount", "unit"],
  "properties": {
    "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$" },
    "unit": { "type": "string", "enum": ["lb", "kg", "oz", "ton", "case", "pallet", "unit"] }
  }
}
