{
  "name": "@dtp/sdk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DTP v0.2 SDK: canonicalization, keys, signing, store client, schema tooling",
  "scripts": {
    "build": "node scripts/build-schemas.ts",
    "check:runtime": "node tests/fuzz/repro-v8-check.mjs tests/fuzz/v8-repro/polluter.min.json tests/fuzz/v8-repro/target.min.json print",
    "check:transitions": "node --test tests/03_records.test.ts tests/06_redteam.test.ts tests/07_infra.test.ts",
    "test:fuzz": "node --test tests/fuzz/fuzz-canonical.test.ts tests/fuzz/fuzz-encodings.test.ts tests/fuzz/fuzz-signing.test.ts tests/fuzz/race-store.test.ts",
    "typecheck": "tsc --noEmit",
    "test:postgres": "node --test tests/postgres/concurrency.test.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "seed": "node scripts/seed.ts",
    "keygen": "node scripts/keygen.ts",
    "sign": "node scripts/sign.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.4.1",
    "json-schema-to-typescript": "^15.0.4",
    "postgres": "^3.4.9",
    "supabase": "^2.40.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.23.2 <23"
  }
}
